# 복사해서 .env.local로 저장한 뒤 값을 채운다. (.env.local은 깃에 올라가지 않는다)
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹)에서 확인한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kkuvcd-2027-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kkuvcd-2027-web
VITE_FIREBASE_APP_ID=

# 미디어 Worker 배포 주소 (예: https://kkuvcd-2027-media.<계정>.workers.dev)
VITE_MEDIA_API_URL=
